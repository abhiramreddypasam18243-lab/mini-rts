## Turns experiment CSVs into the report tables (SPEC 16; AC-71, AC-72).
##   godot --headless --script res://tools/analyze.gd -- --out docs/experiment-tables.md a.csv b.csv ...
## Per pairing: side A's win rate over decisive matches with a Wilson 95 %
## interval; draws and timeouts reported separately; means of duration,
## time to first attack, resources gathered and units lost per side; and a
## paired comparison over seeds (each seed is played twice with swapped
## sides) with a two-sided sign test.
extends SceneTree


func _initialize() -> void:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	var out_path: String = "docs/experiment-tables.md"
	var files: PackedStringArray = []
	var i: int = 0
	while i < args.size():
		if args[i] == "--out" and i + 1 < args.size():
			out_path = args[i + 1]
			i += 2
		else:
			files.append(args[i])
			i += 1
	var md: PackedStringArray = ["# Experiment tables", "",
		"Generated by `tools/analyze.gd` from %s." % ", ".join(Array(files).map(func(p: String) -> String: return "`%s`" % p)), ""]
	for path: String in files:
		var rows: Array[Dictionary] = Experiment.from_csv(FileAccess.get_file_as_string(path))
		if rows.is_empty():
			continue
		md.append_array(_pairing(rows))
	var f: FileAccess = FileAccess.open(out_path, FileAccess.WRITE)
	f.store_string("\n".join(md) + "\n")
	f.close()
	print("\n".join(md))
	quit(0)


func _pairing(rows: Array[Dictionary]) -> PackedStringArray:
	var a: String = rows[0].side_a_policy
	var b: String = rows[0].side_b_policy
	var wins_a: int = 0
	var wins_b: int = 0
	var draws: int = 0
	var timeouts: int = 0
	var dur: Array = []
	var first: Array = []
	var res_a: Array = []
	var res_b: Array = []
	var lost_a: Array = []
	var lost_b: Array = []
	var a_from_player_start: int = 0
	var a_from_player_start_wins: int = 0
	for r: Dictionary in rows:
		match r.winner:
			"A":
				wins_a += 1
			"B":
				wins_b += 1
		if r.outcome == "draw":
			draws += 1
		elif r.outcome == "timeout":
			timeouts += 1
		dur.append(r.duration_ticks)
		if r.first_attack_tick >= 0:
			first.append(r.first_attack_tick)
		res_a.append(r.wood_gathered_a + r.gold_gathered_a)
		res_b.append(r.wood_gathered_b + r.gold_gathered_b)
		lost_a.append(r.units_lost_a)
		lost_b.append(r.units_lost_b)
		if r.a_is_player_start:
			a_from_player_start += 1
			if r.winner == "A":
				a_from_player_start_wins += 1
	var decisive: int = wins_a + wins_b
	var ci: Vector2 = Stats.wilson(wins_a, decisive)
	# Start-position check: how often the player start beat the AI start,
	# whichever policy played there. With identical policies this, not
	# side A's rate (0.5 by construction), is the bias check (AC-71).
	var start_wins: int = 0
	for r: Dictionary in rows:
		if (r.winner == "A") == r.a_is_player_start and r.winner != "":
			start_wins += 1
	var start_ci: Vector2 = Stats.wilson(start_wins, decisive)
	# Paired by seed: the two matches of one seed, with sides swapped.
	var by_seed: Dictionary = {}
	for r: Dictionary in rows:
		if not by_seed.has(r.seed):
			by_seed[r.seed] = []
		by_seed[r.seed].append(r.winner)
	var both_a: int = 0
	var both_b: int = 0
	var split: int = 0
	for s: Variant in by_seed:
		var w: Array = by_seed[s]
		if w.size() < 2:
			continue
		if w[0] == "A" and w[1] == "A":
			both_a += 1
		elif w[0] == "B" and w[1] == "B":
			both_b += 1
		else:
			split += 1
	var sec: Callable = func(ticks: float) -> String: return "%.0f s (%d ticks)" % [ticks / Consts.TICKS_PER_SECOND, roundi(ticks)]
	var out: PackedStringArray = [
		"## %s (A) vs %s (B)" % [a, b], "",
		"| Measure | Value |", "| --- | --- |",
		"| Matches | %d (%d seeds, sides swapped) |" % [rows.size(), by_seed.size()],
		"| A wins / B wins | %d / %d |" % [wins_a, wins_b],
		"| Draws / timeouts (reported separately) | %d / %d |" % [draws, timeouts],
		"| **A win rate (decisive matches)** | **%.3f**, 95 %% Wilson CI [%.3f, %.3f] |" % [float(wins_a) / maxi(decisive, 1), ci.x, ci.y],
		"| A wins from the player start / from the AI start | %d of %d / %d of %d |" % [a_from_player_start_wins, a_from_player_start, wins_a - a_from_player_start_wins, rows.size() - a_from_player_start],
		"| Paired by seed: A won both / split / B won both | %d / %d / %d (sign test p = %.4f) |" % [both_a, split, both_b, Stats.sign_test(both_a, both_b)],
		"| Mean match duration | %s |" % sec.call(Stats.mean(dur)),
		"| Mean time to first attack | %s (in %d matches) |" % [sec.call(Stats.mean(first)), first.size()],
		"| Mean resources gathered A / B | %.0f / %.0f |" % [Stats.mean(res_a), Stats.mean(res_b)],
		"| Mean units lost A / B | %.1f / %.1f |" % [Stats.mean(lost_a), Stats.mean(lost_b)],
		"| A's CI contains 0.5? | %s |" % ("yes" if ci.x <= 0.5 and ci.y >= 0.5 else "no"),
		"| Player-start win rate (decisive matches) | %.3f, 95 %% Wilson CI [%.3f, %.3f]: %s |" % [float(start_wins) / maxi(decisive, 1), start_ci.x, start_ci.y,
			"contains 0.5, no start bias detected" if start_ci.x <= 0.5 and start_ci.y >= 0.5 else "does not contain 0.5"],
		"",
	]
	return out
